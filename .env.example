# TalentMatch AI Configuration
APP_NAME="TalentMatch AI - Job Matching & Career Co-Pilot Agent"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Database Configuration
DATABASE_URL="sqlite:///./data/talent_match.db"

# LLM Configuration
# Supports: "openai", "groq", "gemini", or "local_mock" (for zero-cost deterministic testing)
LLM_PROVIDER="local_mock"
LLM_MODEL="gpt-4o-mini"
OPENAI_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""

# Embeddings & Search Configuration
# Options: "local_dense" (uses sentence-transformers / normalized embeddings), "faiss", "openai"
EMBEDDING_PROVIDER="local_dense"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5

# Agent Memory & Context Settings
MAX_CHAT_TURNS_MEMORY=10
AUTO_EXTRACT_CANDIDATE_MEMORY=True
